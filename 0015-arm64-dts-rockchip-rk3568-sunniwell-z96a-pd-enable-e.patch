From 295d1186885ddeb56753bd7f6b19b87b4356b382 Mon Sep 17 00:00:00 2001
From: Jun Yan <jerrysteve1101@gmail.com>
Date: Sat, 10 Oct 2026 00:10:32 +0800
Subject: [PATCH 15/22] arm64: dts: rockchip: rk3568-sunniwell-z96a-pd: enable
 eDP display

Enable the internal BOE NV140FHD-N43 eDP panel on the RK3568 eDP
controller (driven by the analogix_dp and Naneng eDP PHY), wired to
VOP2 vp1.

Signed-off-by: Jun Yan <jerrysteve1101@gmail.com>
---
 .../rockchip/rk3568-sunniwell-z96a-typec.dts  | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-typec.dts b/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-typec.dts
index 534dc512cc30..a529350292e5 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-typec.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-sunniwell-z96a-typec.dts
@@ -22,6 +22,16 @@ aliases {
 		serial0 = &uart2;
 	};
 
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		brightness-levels = <20 220>;
+		default-brightness-level = <200>;
+		enable-gpios = <&gpio2 RK_PD5 GPIO_ACTIVE_HIGH>;
+		num-interpolated-steps = <200>;
+		power-supply = <&vcc3v3_sys>;
+		pwms = <&pwm9 0 25000 0>;
+	};
+
 	chosen: chosen {
 		stdout-path = "serial2:1500000n8";
 	};
@@ -903,6 +913,49 @@ vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
 	};
 };
 
+&vp1 {
+	vp1_out_edp: endpoint@ROCKCHIP_VOP2_EP_EDP0 {
+		reg = <ROCKCHIP_VOP2_EP_EDP0>;
+		remote-endpoint = <&edp_in_vp1>;
+	};
+};
+
+&edp_phy {
+	status = "okay";
+};
+
+&edp {
+	force-hpd;
+	status = "okay";
+
+	aux-bus {
+		panel: panel {
+			compatible = "edp-panel";
+			backlight = <&backlight>;
+			power-supply = <&vcc3v3_lcd0_n>;
+			no-hpd;
+
+			port {
+				panel_in_edp: endpoint {
+					remote-endpoint = <&edp_out_panel>;
+				};
+			};
+		};
+	};
+};
+
+&edp_in {
+	edp_in_vp1: endpoint {
+		remote-endpoint = <&vp1_out_edp>;
+	};
+};
+
+&edp_out {
+	edp_out_panel: endpoint {
+		remote-endpoint = <&panel_in_edp>;
+	};
+};
+
 /*
  * The RT1711H INT line (GPIO0_C5) is left as an output by the bootloader,
  * which makes gpiochip_lock_as_irq() refuse to use it as an interrupt source
-- 
2.56.0

