From 4bbabe8ba02a59f6a186b7724ff765eb173285fe Mon Sep 17 00:00:00 2001
From: Jun Yan <jerrysteve1101@gmail.com>
Date: Thu, 8 Oct 2026 22:13:43 +0800
Subject: [PATCH 17/22] dt-bindings: mfd: bq25703a: Add Southchip SC8886S

The SC8886S is a register-compatible second source for the TI BQ25703A
buck/boost battery charger.
---
 Documentation/devicetree/bindings/mfd/ti,bq25703a.yaml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/mfd/ti,bq25703a.yaml b/Documentation/devicetree/bindings/mfd/ti,bq25703a.yaml
index cdce83f05804..9ab48ec2adb1 100644
--- a/Documentation/devicetree/bindings/mfd/ti,bq25703a.yaml
+++ b/Documentation/devicetree/bindings/mfd/ti,bq25703a.yaml
@@ -14,6 +14,7 @@ properties:
     enum:
       - ti,bq25703a
       - ti,bq25792
+      - southchip,sc8886s
 
   reg:
     const: 0x6b
@@ -77,7 +78,9 @@ allOf:
   - if:
       properties:
         compatible:
-          const: ti,bq25703a
+          enum:
+            - ti,bq25703a
+            - southchip,sc8886s
     then:
       properties:
         input-current-limit-microamp:
-- 
2.56.0

